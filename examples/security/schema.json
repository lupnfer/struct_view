{
  "deviceCtxType": "MyDeviceCtx",
  "structs": [
    {"name": "Event", "members": [
        {"field": "timestamp", "as": "time", "desc": "时间戳", "type": "uint64"},
        {"block": "person", "desc": "人体信息", "ptr": true, "sep": "-", "fields": ["name", "age"]},
        {"block": "rect",   "desc": "检测框",   "sep": ",", "fields": ["x", "y", "w", "h", "tags"]},
        {"field": "feature_ids", "as": "feat_ids", "desc": "特征ID列表", "type": "int",
         "array": {"count": 8, "sep": "-"}},
        {"block": "boxes", "desc": "检测框数组", "sep": ",", "fields": ["x", "y", "w", "h", "tags"],
         "array": {"count": 4, "sep": "|"}}
    ]},
    {"name": "PersonInfo", "members": [
        {"field": "name", "desc": "姓名", "type": "cstr"},
        {"field": "age",  "desc": "年龄", "type": "int"}
    ]},
    {"name": "Box", "members": [
        {"field": "x", "desc": "横坐标", "type": "int"},
        {"field": "y", "desc": "纵坐标", "type": "int"},
        {"field": "w", "desc": "宽", "type": "int"},
        {"field": "h", "desc": "高", "type": "int"},
        {"field": "tags", "desc": "标签", "type": "int", "array": {"count": 2, "sep": "-"}}
    ]}
  ],
  "device": [{"getter": "cameraId", "as": "camera", "desc": "摄像头编号"}]
}
